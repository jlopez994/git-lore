{
  "name": "git-lore",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "jlopez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jlopez994/git-lore.git"
  },
  "bugs": {
    "url": "https://github.com/jlopez994/git-lore/issues"
  },
  "homepage": "https://github.com/jlopez994/git-lore#readme",
  "author": "Julián L.",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A1530",
    "theme": "dark"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "blame",
    "history",
    "file history",
    "line history",
    "commit graph",
    "compare",
    "open source"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "ovsx": "^1.4.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitLore.toggleFileBlame",
        "title": "%command.toggleFileBlame%",
        "category": "Git Lore",
        "icon": "$(person)"
      },
      {
        "command": "gitLore.toggleCurrentLine",
        "title": "%command.toggleCurrentLine%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.fileHistory",
        "title": "%command.fileHistory%",
        "category": "Git Lore",
        "icon": "$(history)"
      },
      {
        "command": "gitLore.lineHistory",
        "title": "%command.lineHistory%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.refreshHistory",
        "title": "%command.refresh%",
        "category": "Git Lore",
        "icon": "$(refresh)"
      },
      {
        "command": "gitLore.showGraph",
        "title": "%command.showGraph%",
        "category": "Git Lore",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitLore.compareRefs",
        "title": "%command.compareRefs%",
        "category": "Git Lore",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitLore.swapCompare",
        "title": "%command.swapCompare%",
        "category": "Git Lore",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "gitLore.showCommit",
        "title": "%command.showCommit%",
        "category": "Git Lore",
        "icon": "$(files)"
      },
      {
        "command": "gitLore.copySha",
        "title": "%command.copySha%",
        "category": "Git Lore",
        "icon": "$(copy)"
      },
      {
        "command": "gitLore.openOnRemote",
        "title": "%command.openOnRemote%",
        "category": "Git Lore",
        "icon": "$(globe)"
      },
      {
        "command": "gitLore.openChanges",
        "title": "%command.openChanges%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.openComparedFile",
        "title": "%command.openChanges%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.checkout",
        "title": "%command.graph.checkout%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.createBranch",
        "title": "%command.graph.createBranch%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.createTag",
        "title": "%command.graph.createTag%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.merge",
        "title": "%command.graph.merge%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.cherryPick",
        "title": "%command.graph.cherryPick%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.revert",
        "title": "%command.graph.revert%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.reset",
        "title": "%command.graph.reset%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.deleteBranch",
        "title": "%command.graph.deleteBranch%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.deleteTag",
        "title": "%command.graph.deleteTag%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.copySha",
        "title": "%command.copySha%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.openDiff",
        "title": "%command.graph.openDiff%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.openRevision",
        "title": "%command.graph.openRevision%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.compareWorking",
        "title": "%command.graph.compareWorking%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.openFile",
        "title": "%command.graph.openFile%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.copyPath",
        "title": "%command.graph.copyPath%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.copyRelativePath",
        "title": "%command.graph.copyRelativePath%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.restoreFile",
        "title": "%command.graph.restoreFile%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.visualFileHistory",
        "title": "%command.visualFileHistory%",
        "category": "Git Lore",
        "icon": "$(graph-scatter)"
      },
      {
        "command": "gitLore.graph.applyStash",
        "title": "%command.graph.applyStash%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.popStash",
        "title": "%command.graph.popStash%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.dropStash",
        "title": "%command.graph.dropStash%",
        "category": "Git Lore"
      },
      {
        "command": "gitLore.graph.openWorktree",
        "title": "%command.graph.openWorktree%",
        "category": "Git Lore"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gitLore.showCommit",
          "when": "false"
        },
        {
          "command": "gitLore.copySha",
          "when": "false"
        },
        {
          "command": "gitLore.openOnRemote",
          "when": "false"
        },
        {
          "command": "gitLore.openChanges",
          "when": "false"
        },
        {
          "command": "gitLore.openComparedFile",
          "when": "false"
        },
        {
          "command": "gitLore.swapCompare",
          "when": "gitLore.comparing"
        },
        {
          "command": "gitLore.toggleFileBlame",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitLore.lineHistory",
          "when": "editorTextFocus && resourceScheme == file"
        },
        {
          "command": "gitLore.graph.checkout",
          "when": "false"
        },
        {
          "command": "gitLore.graph.createBranch",
          "when": "false"
        },
        {
          "command": "gitLore.graph.createTag",
          "when": "false"
        },
        {
          "command": "gitLore.graph.merge",
          "when": "false"
        },
        {
          "command": "gitLore.graph.cherryPick",
          "when": "false"
        },
        {
          "command": "gitLore.graph.revert",
          "when": "false"
        },
        {
          "command": "gitLore.graph.reset",
          "when": "false"
        },
        {
          "command": "gitLore.graph.deleteBranch",
          "when": "false"
        },
        {
          "command": "gitLore.graph.deleteTag",
          "when": "false"
        },
        {
          "command": "gitLore.graph.copySha",
          "when": "false"
        },
        {
          "command": "gitLore.graph.openDiff",
          "when": "false"
        },
        {
          "command": "gitLore.graph.openRevision",
          "when": "false"
        },
        {
          "command": "gitLore.graph.compareWorking",
          "when": "false"
        },
        {
          "command": "gitLore.graph.openFile",
          "when": "false"
        },
        {
          "command": "gitLore.graph.copyPath",
          "when": "false"
        },
        {
          "command": "gitLore.graph.copyRelativePath",
          "when": "false"
        },
        {
          "command": "gitLore.graph.restoreFile",
          "when": "false"
        },
        {
          "command": "gitLore.visualFileHistory",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitLore.graph.applyStash",
          "when": "false"
        },
        {
          "command": "gitLore.graph.popStash",
          "when": "false"
        },
        {
          "command": "gitLore.graph.dropStash",
          "when": "false"
        },
        {
          "command": "gitLore.graph.openWorktree",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "gitLore.toggleFileBlame",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitLore.fileHistory",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "gitLore@1"
        },
        {
          "command": "gitLore.visualFileHistory",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "gitLore@2"
        }
      ],
      "editor/context": [
        {
          "command": "gitLore.lineHistory",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "gitLore@1"
        },
        {
          "command": "gitLore.toggleFileBlame",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "gitLore@2"
        },
        {
          "command": "gitLore.visualFileHistory",
          "when": "resourceScheme == file && gitOpenRepositoryCount != 0",
          "group": "gitLore@3"
        }
      ],
      "explorer/context": [
        {
          "command": "gitLore.fileHistory",
          "when": "!explorerResourceIsFolder && gitOpenRepositoryCount != 0",
          "group": "gitLore@1"
        },
        {
          "command": "gitLore.visualFileHistory",
          "when": "!explorerResourceIsFolder && gitOpenRepositoryCount != 0",
          "group": "gitLore@2"
        }
      ],
      "scm/title": [
        {
          "command": "gitLore.showGraph",
          "when": "scmProvider == git",
          "group": "navigation@-3"
        },
        {
          "command": "gitLore.compareRefs",
          "when": "scmProvider == git",
          "group": "navigation@-2"
        }
      ],
      "view/title": [
        {
          "command": "gitLore.visualFileHistory",
          "when": "view == gitLore.history",
          "group": "navigation@0"
        },
        {
          "command": "gitLore.refreshHistory",
          "when": "view == gitLore.history",
          "group": "navigation"
        },
        {
          "command": "gitLore.swapCompare",
          "when": "view == gitLore.compare && gitLore.comparing",
          "group": "navigation@1"
        },
        {
          "command": "gitLore.compareRefs",
          "when": "view == gitLore.compare",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gitLore.showCommit",
          "when": "view == gitLore.history && viewItem == commit",
          "group": "inline@1"
        },
        {
          "command": "gitLore.showCommit",
          "when": "view == gitLore.history && viewItem == commit",
          "group": "1_commit@1"
        },
        {
          "command": "gitLore.copySha",
          "when": "view == gitLore.history && viewItem == commit",
          "group": "1_commit@2"
        },
        {
          "command": "gitLore.openOnRemote",
          "when": "view == gitLore.history && viewItem == commit",
          "group": "1_commit@3"
        }
      ],
      "webview/context": [
        {
          "command": "gitLore.graph.createBranch",
          "when": "webviewId == 'gitLore.graph' && webviewSection == commit",
          "group": "1_crear@1"
        },
        {
          "command": "gitLore.graph.createTag",
          "when": "webviewId == 'gitLore.graph' && webviewSection == commit",
          "group": "1_crear@2"
        },
        {
          "command": "gitLore.graph.checkout",
          "when": "webviewId == 'gitLore.graph' && webviewSection == commit",
          "group": "2_checkout@1"
        },
        {
          "command": "gitLore.graph.cherryPick",
          "when": "webviewId == 'gitLore.graph' && webviewSection == commit",
          "group": "3_cambios@1"
        },
        {
          "command": "gitLore.graph.revert",
          "when": "webviewId == 'gitLore.graph' && webviewSection == commit",
          "group": "3_cambios@2"
        },
        {
          "command": "gitLore.graph.reset",
          "when": "webviewId == 'gitLore.graph' && webviewSection == commit",
          "group": "3_cambios@3"
        },
        {
          "command": "gitLore.graph.checkout",
          "when": "webviewId == 'gitLore.graph' && webviewSection == rama && !esHead && !worktree",
          "group": "1_rama@1"
        },
        {
          "command": "gitLore.graph.merge",
          "when": "webviewId == 'gitLore.graph' && webviewSection == rama && !esHead",
          "group": "1_rama@2"
        },
        {
          "command": "gitLore.graph.deleteBranch",
          "when": "webviewId == 'gitLore.graph' && webviewSection == rama && !esHead && !worktree",
          "group": "9_borrar@1"
        },
        {
          "command": "gitLore.graph.checkout",
          "when": "webviewId == 'gitLore.graph' && webviewSection == remota",
          "group": "1_rama@1"
        },
        {
          "command": "gitLore.graph.merge",
          "when": "webviewId == 'gitLore.graph' && webviewSection == remota",
          "group": "1_rama@2"
        },
        {
          "command": "gitLore.graph.checkout",
          "when": "webviewId == 'gitLore.graph' && webviewSection == tag",
          "group": "1_rama@1"
        },
        {
          "command": "gitLore.graph.deleteTag",
          "when": "webviewId == 'gitLore.graph' && webviewSection == tag",
          "group": "9_borrar@1"
        },
        {
          "command": "gitLore.graph.copySha",
          "when": "webviewId == 'gitLore.graph' && webviewSection =~ /^(commit|rama|remota|tag|stash|worktree)$/",
          "group": "8_copiar@1"
        },
        {
          "command": "gitLore.graph.openDiff",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero",
          "group": "1_ver@1"
        },
        {
          "command": "gitLore.graph.openRevision",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero",
          "group": "1_ver@2"
        },
        {
          "command": "gitLore.graph.compareWorking",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero && estadoFichero != D",
          "group": "1_ver@3"
        },
        {
          "command": "gitLore.graph.openFile",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero && estadoFichero != D",
          "group": "1_ver@4"
        },
        {
          "command": "gitLore.graph.copyPath",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero",
          "group": "2_copiar@1"
        },
        {
          "command": "gitLore.graph.copyRelativePath",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero",
          "group": "2_copiar@2"
        },
        {
          "command": "gitLore.graph.restoreFile",
          "when": "webviewId == 'gitLore.graph' && webviewSection == fichero && estadoFichero != D && estadoFichero != R",
          "group": "9_restaurar@1"
        },
        {
          "command": "gitLore.graph.applyStash",
          "when": "webviewId == 'gitLore.graph' && webviewSection == stash",
          "group": "1_stash@1"
        },
        {
          "command": "gitLore.graph.popStash",
          "when": "webviewId == 'gitLore.graph' && webviewSection == stash",
          "group": "1_stash@2"
        },
        {
          "command": "gitLore.graph.dropStash",
          "when": "webviewId == 'gitLore.graph' && webviewSection == stash",
          "group": "9_borrar@1"
        },
        {
          "command": "gitLore.graph.openWorktree",
          "when": "webviewId == 'gitLore.graph' && webviewSection =~ /^(rama|worktree)$/ && worktree",
          "group": "1_rama@0"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "gitLore.history",
          "name": "%view.history%",
          "icon": "$(history)"
        },
        {
          "id": "gitLore.compare",
          "name": "%view.compare%",
          "icon": "$(git-compare)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gitLore.compare",
        "contents": "%welcome.compare%",
        "when": "!gitLore.comparing"
      }
    ],
    "colors": [
      {
        "id": "gitLore.currentLineForeground",
        "description": "%color.currentLine%",
        "defaults": {
          "dark": "#99999980",
          "light": "#77777799",
          "highContrast": "#ffffffaa",
          "highContrastLight": "#000000aa"
        }
      },
      {
        "id": "gitLore.fileBlameForeground",
        "description": "%color.fileBlame%",
        "defaults": {
          "dark": "#a0a0a0",
          "light": "#6a6a6a",
          "highContrast": "#ffffff",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gitLore.fileBlameBackground",
        "description": "%color.fileBlameBackground%",
        "defaults": {
          "dark": "#ffffff08",
          "light": "#0000000a",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      }
    ],
    "configuration": {
      "title": "Git Lore",
      "properties": {
        "gitLore.currentLine.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.currentLine%"
        }
      }
    }
  }
}
